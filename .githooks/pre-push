#!/usr/bin/env bash
# Blocks pushes that introduce secrets. Bypass (not recommended): git push --no-verify
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found; install it: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # branch deletion
  if [[ "$remote_sha" == "$zero" ]]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! gitleaks git . --no-banner --redact --log-opts="$range"; then
    echo "pre-push: gitleaks found secrets in $local_ref; push aborted." >&2
    status=1
  fi
done

exit $status
